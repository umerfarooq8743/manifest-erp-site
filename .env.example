# Manifest ERP website — environment variables
# Copy to .env.local for local development, or set them in Vercel → Project → Settings → Environment Variables.
# All values are optional. Anything left empty is hidden on the site (no placeholder contact details are ever shown).

# Production domain, used for canonical URLs, Open Graph, sitemap and robots.txt.
# On Vercel the production domain is detected automatically if this is empty.
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business number in international format, digits only (no +, spaces or leading 00).
# Example format: 923001234567. Inquiry forms open https://wa.me/<number> with the visitor's message.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Sales / demo email address shown on the contact page and footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Phone number exactly as it should be displayed, e.g. +92 21 0000 0000
NEXT_PUBLIC_CONTACT_PHONE=

# Optional, e.g. Mon–Sat, 9:00–18:00 PKT
NEXT_PUBLIC_BUSINESS_HOURS=
